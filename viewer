/* Which part of each step to outline: the biggest group of identical, touching-block pieces (all the posts, both balconies, every dormer...). */
function focusSteps(vox,N,ovr){
  const key=v=>v.x+','+v.y+','+v.z,gy=Math.min(...vox.map(v=>v.y));
  return Array.from({length:N},(_,i)=>{
    let S=vox.filter(v=>v.s===i);const only=ovr&&ovr[i];
    if(Array.isArray(only)){const f=S.filter(v=>only.includes(v.b));if(f.length)S=f}
    if(!S.length)return null;
    const at=new Map(S.map(v=>[key(v),v])),seen=new Set(),comps=[];
    if(only==='all')comps.push(S);
    else S.forEach(v=>{
      if(seen.has(key(v)))return;
      const comp=[],q=[v];seen.add(key(v));
      while(q.length){const c=q.pop();comp.push(c);
        for(let dx=-1;dx<=1;dx++)for(let dy=-1;dy<=1;dy++)for(let dz=-1;dz<=1;dz++){
          const m=at.get((c.x+dx)+','+(c.y+dy)+','+(c.z+dz));
          if(m&&!seen.has(key(m))){seen.add(key(m));q.push(m)}}}
      comps.push(comp)});
    const dims=c=>{const r=a=>[Math.min(...a),Math.max(...a)];
      const [x1,x2]=r(c.map(v=>v.x)),[y1,y2]=r(c.map(v=>v.y)),[z1,z2]=r(c.map(v=>v.z));
      return {x1,x2,y1,y2,z1,z2,w:x2-x1+1,h:y2-y1+1,d:z2-z1+1}};
    const groups=new Map();
    comps.forEach(c=>{const d=dims(c),k=d.w+'x'+d.d+'x'+d.h,g=groups.get(k)||{n:0,blocks:0,rep:null};
      g.n++;g.blocks+=c.length;if(!g.rep||c.length>g.rep.length)g.rep=c;groups.set(k,g)});
    const best=[...groups.values()].sort((a,b)=>b.blocks-a.blocks)[0],d=dims(best.rep);
    return Object.assign(d,{n:best.n,same:best.n===comps.length,l1:d.y1-gy+1,l2:d.y2-gy+1});
  });
}
