{id:"cozy-cottage",name:"Cozy Cottage",emoji:"🏡",tags:["Houses","Survival","Starter"],diff:"Easy",time:"30 min",size:"9×7",photos:[P5],pr:[1.651],photoCredit:"",desc:"A snug starter home with a pitched roof and warm lighting.",steps:[
